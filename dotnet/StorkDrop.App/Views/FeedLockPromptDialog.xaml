<Window
  x:Class="StorkDrop.App.Views.FeedLockPromptDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="{DynamicResource FeedLock_Title}"
  Width="440"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  Background="{DynamicResource SurfaceBrush}"
>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Text="{DynamicResource FeedLock_Title}"
      Style="{DynamicResource HeadingMedium}"
      Margin="0,0,0,12"
    />

    <TextBlock
      Grid.Row="1"
      x:Name="MessageText"
      Style="{DynamicResource BodyText}"
      TextWrapping="Wrap"
      Margin="0,0,0,12"
    />

    <PasswordBox
      Grid.Row="2"
      x:Name="PasswordInput"
      MinHeight="34"
      Padding="8,6"
      FontSize="13"
      VerticalContentAlignment="Center"
    />

    <TextBlock
      Grid.Row="3"
      x:Name="ErrorText"
      Foreground="{DynamicResource ErrorBrush}"
      FontSize="12"
      Margin="0,6,0,0"
      TextWrapping="Wrap"
      Visibility="Collapsed"
    />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button
        Content="{DynamicResource FeedLock_Cancel}"
        Style="{DynamicResource OutlinedButton}"
        Padding="16,8"
        Margin="0,0,8,0"
        IsCancel="True"
      />
      <Button
        Content="{DynamicResource FeedLock_Unlock}"
        Style="{DynamicResource FilledAccentButton}"
        Padding="16,8"
        IsDefault="True"
        Click="Ok_Click"
      />
    </StackPanel>
  </Grid>
</Window>
