<Window
  x:Class="StorkDrop.App.Views.PluginPromptDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Icon="pack://application:,,,/StorkDrop.App;component/Assets/stork.ico"
  Width="550"
  MinWidth="420"
  MinHeight="220"
  SizeToContent="Height"
  MaxHeight="900"
  WindowStartupLocation="CenterOwner"
  ResizeMode="CanResize"
  Background="White"
>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      x:Name="MessageText"
      Grid.Row="0"
      FontSize="13"
      TextWrapping="Wrap"
      Margin="0,0,0,12"
    />

    <TextBlock
      x:Name="DetailLabel"
      Grid.Row="1"
      Text="Details"
      FontSize="12"
      FontWeight="SemiBold"
      Foreground="#666666"
      Margin="0,0,0,4"
      Visibility="Collapsed"
    />

    <Border
      x:Name="DetailBorder"
      Grid.Row="2"
      Background="#F8F8F8"
      CornerRadius="6"
      Padding="12,10"
      Margin="0,0,0,16"
      Visibility="Collapsed"
    >
      <TextBox
        x:Name="DetailText"
        IsReadOnly="True"
        IsReadOnlyCaretVisible="True"
        BorderThickness="0"
        Background="Transparent"
        Padding="0"
        FontSize="12"
        FontFamily="Consolas"
        Foreground="#444444"
        TextWrapping="NoWrap"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Auto"
      />
    </Border>

    <ItemsControl x:Name="ButtonsPanel" Grid.Row="3">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </Grid>
</Window>
