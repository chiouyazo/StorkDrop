<Window
  x:Class="StorkDrop.App.Views.ChangeVersionDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:StorkDrop.App.Converters"
  Title="{DynamicResource ChangeVersion_Title}"
  Width="720"
  Height="520"
  MinWidth="600"
  MinHeight="400"
  WindowStartupLocation="CenterOwner"
  ResizeMode="CanResize"
  Background="{DynamicResource BackgroundBrush}"
>
  <Window.Resources>
    <converters:BadgeColorConverter x:Key="BadgeColorConverter" />

    <SolidColorBrush
      x:Key="AccentTintBrush"
      Color="{StaticResource AccentRedColor}"
      Opacity="0.12"
    />

    <Style x:Key="ColumnHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
      <Setter Property="Margin" Value="4,0,0,8" />
    </Style>

    <!-- Small text-only toggle / breadcrumb button -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Channel rail item: hover tint, selection tint + accent bar on the left -->
    <Style x:Key="ChannelItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="6"
              Padding="10,8"
              Margin="0,1"
            >
              <Grid>
                <Rectangle
                  x:Name="Accent"
                  Width="3"
                  HorizontalAlignment="Left"
                  RadiusX="2"
                  RadiusY="2"
                  Fill="{DynamicResource AccentRedBrush}"
                  Visibility="Collapsed"
                />
                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="Bd"
                  Property="Background"
                  Value="{DynamicResource SurfaceBrush}"
                />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter
                  TargetName="Bd"
                  Property="Background"
                  Value="{DynamicResource SurfaceBrush}"
                />
                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Version list item: hover + selection tint, no size change on select -->
    <Style x:Key="VersionItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="6"
              Padding="12,9"
              Margin="0,1"
            >
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="Bd"
                  Property="Background"
                  Value="{DynamicResource SurfaceBrush}"
                />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter
                  TargetName="Bd"
                  Property="Background"
                  Value="{StaticResource AccentTintBrush}"
                />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Text="{DynamicResource ChangeVersion_Title}"
      FontSize="18"
      FontWeight="SemiBold"
      Margin="0,0,0,6"
    />
    <TextBlock
      Grid.Row="1"
      x:Name="MessageText"
      TextWrapping="Wrap"
      FontSize="13"
      Foreground="{DynamicResource OnSurfaceVariantBrush}"
      Margin="0,0,0,16"
    />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="200" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left: channels -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
          Grid.Row="0"
          Text="{DynamicResource ChangeVersion_ChannelsHeader}"
          Style="{StaticResource ColumnHeader}"
        />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ListBox
            x:Name="ChannelList"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource ChannelItemStyle}"
            SelectionChanged="ChannelList_SelectionChanged"
          >
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse
                    Grid.Column="0"
                    Width="11"
                    Height="11"
                    VerticalAlignment="Center"
                    Fill="{Binding BadgeColor, Converter={StaticResource BadgeColorConverter}}"
                  />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock
                      Text="{Binding FeedName}"
                      FontSize="13"
                      FontWeight="SemiBold"
                      TextTrimming="CharacterEllipsis"
                    />
                    <TextBlock
                      Text="{Binding LatestVersion, StringFormat='v{0}'}"
                      FontSize="11"
                      Foreground="{DynamicResource OnSurfaceVariantBrush}"
                      TextTrimming="CharacterEllipsis"
                    />
                  </StackPanel>
                  <TextBlock
                    Grid.Column="2"
                    Text="&#x2713;"
                    FontSize="13"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Margin="6,0,0,0"
                    Foreground="{DynamicResource AccentRedBrush}"
                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"
                  />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Grid>

      <Border Grid.Column="1" Width="1" Margin="16,0" Background="{DynamicResource BorderBrush}" />

      <!-- Right: versions of the selected channel -->
      <Grid Grid.Column="2" x:Name="VersionPane">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Grid.Column="0"
            Text="{DynamicResource ChangeVersion_VersionsHeader}"
            Style="{StaticResource ColumnHeader}"
          />
          <Button
            Grid.Column="1"
            x:Name="ViewToggleButton"
            Style="{StaticResource LinkButton}"
            Margin="0,0,4,8"
            Click="ViewToggle_Click"
            Visibility="Collapsed"
          />
        </Grid>

        <!-- Breadcrumb (grouped mode only) -->
        <StackPanel
          Grid.Row="1"
          x:Name="BreadcrumbPanel"
          Orientation="Horizontal"
          Margin="4,0,0,10"
          Visibility="Collapsed"
        />

        <Grid Grid.Row="2">
          <ScrollViewer x:Name="FlatScroller" VerticalScrollBarVisibility="Auto">
            <ListBox
              x:Name="VersionList"
              Background="Transparent"
              BorderThickness="0"
              ItemContainerStyle="{StaticResource VersionItemStyle}"
              SelectionChanged="VersionList_SelectionChanged"
            >
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                      Grid.Column="0"
                      Text="{Binding Version}"
                      FontSize="13"
                      VerticalAlignment="Center"
                      TextTrimming="CharacterEllipsis"
                    />
                    <Border
                      Grid.Column="1"
                      Background="{DynamicResource SuccessBrush}"
                      CornerRadius="9"
                      Padding="7,1"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsNewest, Converter={StaticResource BoolToVisibilityConverter}}"
                    >
                      <TextBlock
                        Text="{DynamicResource ChangeVersion_Newest}"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="White"
                      />
                    </Border>
                    <TextBlock
                      Grid.Column="2"
                      Text="{DynamicResource ChangeVersion_Installed}"
                      FontSize="11"
                      Opacity="0.6"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"
                    />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>

          <!-- Grouped cascade: one level at a time -->
          <ScrollViewer
            x:Name="GroupedScroller"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed"
          >
            <ListBox
              x:Name="GroupedList"
              Background="Transparent"
              BorderThickness="0"
              ItemContainerStyle="{StaticResource VersionItemStyle}"
              SelectionChanged="GroupedList_SelectionChanged"
            >
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                      Grid.Column="0"
                      Text="{Binding Display}"
                      FontSize="13"
                      VerticalAlignment="Center"
                      TextTrimming="CharacterEllipsis"
                    />
                    <TextBlock
                      Grid.Column="1"
                      Text="{DynamicResource ChangeVersion_Installed}"
                      FontSize="11"
                      Opacity="0.6"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"
                    />
                    <TextBlock
                      Grid.Column="2"
                      Text="&#x203A;"
                      FontSize="16"
                      Foreground="{DynamicResource OnSurfaceVariantBrush}"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}"
                    />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>

          <TextBlock
            x:Name="LoadingText"
            Text="{DynamicResource ChangeVersion_Loading}"
            FontSize="13"
            Foreground="{DynamicResource OnSurfaceVariantBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
          />
          <TextBlock
            x:Name="EmptyText"
            Text="{DynamicResource ChangeVersion_NoVersions}"
            FontSize="13"
            Foreground="{DynamicResource OnSurfaceVariantBrush}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
          />
        </Grid>
      </Grid>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button
        Content="{DynamicResource ChangeVersion_Cancel}"
        Style="{DynamicResource OutlinedButton}"
        Padding="16,8"
        Margin="0,0,8,0"
        Click="Cancel_Click"
      />
      <Button
        x:Name="ApplyButton"
        Content="{DynamicResource ChangeVersion_Apply}"
        Style="{DynamicResource FilledAccentButton}"
        Padding="16,8"
        IsEnabled="False"
        Click="Apply_Click"
      />
    </StackPanel>
  </Grid>
</Window>
