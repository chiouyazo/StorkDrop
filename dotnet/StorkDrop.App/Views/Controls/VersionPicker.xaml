<UserControl
  x:Class="StorkDrop.App.Views.Controls.VersionPicker"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <UserControl.Resources>
    <SolidColorBrush x:Key="VP_AccentTint" Color="{StaticResource AccentRedColor}" Opacity="0.12" />

    <Style x:Key="VP_LinkButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="VP_ItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="6"
              Padding="12,9"
              Margin="0,1"
            >
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="Bd"
                  Property="Background"
                  Value="{DynamicResource SurfaceBrush}"
                />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter
                  TargetName="Bd"
                  Property="Background"
                  Value="{StaticResource VP_AccentTint}"
                />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Button
      Grid.Row="0"
      x:Name="ViewToggleButton"
      Style="{StaticResource VP_LinkButton}"
      HorizontalAlignment="Right"
      Margin="0,0,4,6"
      Click="ViewToggle_Click"
      Visibility="Collapsed"
    />

    <StackPanel
      Grid.Row="1"
      x:Name="BreadcrumbPanel"
      Orientation="Horizontal"
      Margin="4,0,0,8"
      Visibility="Collapsed"
    />

    <Grid Grid.Row="2">
      <ScrollViewer x:Name="FlatScroller" VerticalScrollBarVisibility="Auto">
        <ListBox
          x:Name="FlatList"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource VP_ItemStyle}"
          SelectionChanged="FlatList_SelectionChanged"
        >
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Text="{Binding Version}"
                  FontSize="13"
                  VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis"
                />
                <Border
                  Grid.Column="1"
                  Background="{DynamicResource SuccessBrush}"
                  CornerRadius="9"
                  Padding="7,1"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsNewest, Converter={StaticResource BoolToVisibilityConverter}}"
                >
                  <TextBlock
                    Text="{DynamicResource ChangeVersion_Newest}"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="White"
                  />
                </Border>
                <TextBlock
                  Grid.Column="2"
                  Text="{DynamicResource ChangeVersion_Installed}"
                  FontSize="11"
                  Opacity="0.6"
                  VerticalAlignment="Center"
                  Margin="8,0,0,0"
                  Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"
                />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>

      <ScrollViewer
        x:Name="GroupedScroller"
        VerticalScrollBarVisibility="Auto"
        Visibility="Collapsed"
      >
        <ListBox
          x:Name="GroupedList"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource VP_ItemStyle}"
          SelectionChanged="GroupedList_SelectionChanged"
        >
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Text="{Binding Display}"
                  FontSize="13"
                  VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="{DynamicResource ChangeVersion_Installed}"
                  FontSize="11"
                  Opacity="0.6"
                  VerticalAlignment="Center"
                  Margin="8,0,0,0"
                  Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"
                />
                <TextBlock
                  Grid.Column="2"
                  Text="&#x203A;"
                  FontSize="16"
                  Foreground="{DynamicResource OnSurfaceVariantBrush}"
                  VerticalAlignment="Center"
                  Margin="8,0,0,0"
                  Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}"
                />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>

      <TextBlock
        x:Name="EmptyText"
        Text="{DynamicResource ChangeVersion_NoVersions}"
        FontSize="13"
        Foreground="{DynamicResource OnSurfaceVariantBrush}"
        TextWrapping="Wrap"
        TextAlignment="Center"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Visibility="Collapsed"
      />
    </Grid>
  </Grid>
</UserControl>
