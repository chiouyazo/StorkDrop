<Window
  x:Class="StorkDrop.App.Views.NotesDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="{DynamicResource Notes_Title}"
  Width="520"
  Height="460"
  MinWidth="380"
  MinHeight="300"
  WindowStartupLocation="CenterOwner"
  ResizeMode="CanResize"
  Background="{DynamicResource BackgroundBrush}"
>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Text="{DynamicResource Notes_Title}"
      FontSize="18"
      FontWeight="SemiBold"
      Margin="0,0,0,6"
    />
    <TextBlock
      Grid.Row="1"
      x:Name="MessageText"
      TextWrapping="Wrap"
      FontSize="13"
      Foreground="{DynamicResource OnSurfaceVariantBrush}"
      Margin="0,0,0,12"
    />

    <TextBox
      Grid.Row="2"
      x:Name="NotesTextBox"
      AcceptsReturn="True"
      AcceptsTab="True"
      TextWrapping="Wrap"
      VerticalScrollBarVisibility="Auto"
      VerticalContentAlignment="Top"
      Padding="8"
      FontSize="13"
      Background="{DynamicResource SurfaceBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1"
    />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button
        Content="{DynamicResource Notes_Cancel}"
        Style="{DynamicResource OutlinedButton}"
        Padding="16,8"
        Margin="0,0,8,0"
        Click="Cancel_Click"
      />
      <Button
        Content="{DynamicResource Notes_Save}"
        Style="{DynamicResource FilledAccentButton}"
        Padding="16,8"
        Click="Save_Click"
      />
    </StackPanel>
  </Grid>
</Window>
